# Скопируйте этот файл в .env и впишите ключ. Файл .env в git не попадает.
# Провайдер: openrouter (по умолчанию) | gemini (бесплатно) | openai | offline (без LLM, только правила)
LLM_PROVIDER=openrouter

# --- OpenRouter: модель, на которой сделан сдаваемый отчёт ---------------------------------------
# Ключ: https://openrouter.ai/settings/keys (нужен баланс; прогон ≈ $0.7). Поставьте на ключ лимит расходов.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Запасная модель, если основная недоступна (429/503 после всех попыток):
# OPENROUTER_FALLBACK_MODEL=google/gemini-3.8-flash
# Формат структурированного ответа подбирается автоматически; задать вручную (обычно не нужно):
# json_schema | json_schema_noseed | json_schema_notemp | tool | prompt
# OPENROUTER_MODE=

# --- Google Gemini: бесплатная альтернатива (качество ниже, см. README) --------------------------
# Ключ: https://aistudio.google.com/apikey. Запуск: LLM_PROVIDER=gemini или флаг --provider gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Запасная: при перегрузке 3.8 Flash (503) и для большего дневного лимита бесплатного тарифа
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Необязательно: любой OpenAI-совместимый API (OpenAI, Ollama, vLLM, LM Studio) ---------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b

# --- Тонкие настройки (значения по умолчанию подходят) -------------------------------------------
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=4
# Пауза между запросами, сек. По умолчанию: Gemini — 4 (лимит запросов в минуту), OpenRouter — 0.
# LLM_MIN_INTERVAL=
# Параллельных запросов. По умолчанию: Gemini — 1, OpenRouter — 4.
# LLM_CONCURRENCY=
# Максимальная длина ответа модели в токенах (рассуждения модели расходуют тот же лимит).
LLM_MAX_OUTPUT_TOKENS=32768
# Глубина рассуждений: low | medium | high (пусто — по умолчанию модели).
# LLM_REASONING_EFFORT=low
# Предохранитель: после стольких шагов подряд с недоступной моделью остальные шаги пропускаются.
LLM_BREAKER_AFTER=2
