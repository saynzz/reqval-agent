# Скопируйте этот файл в .env и укажите ключ. Файл .env в git не попадает.

# Провайдер: gemini (по умолчанию) | openai | offline
LLM_PROVIDER=gemini

# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (платный ключ, для разработки): LLM_PROVIDER=openrouter
# Ключ: https://openrouter.ai/settings/keys — поставьте на ключ лимит расходов.
# Модель: точный id со страницы модели на openrouter.ai (без алиасов вида ~google/...-latest:
# они меняют модель без предупреждения, и прогон нельзя воспроизвести).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.1-pro-preview
# Формат структурированного ответа (обычно не нужен — агент подбирает сам):
# json_schema | json_schema_noseed | json_schema_notemp | tool | prompt.
# Для anthropic/* по умолчанию json_schema_notemp: у Claude с постоянным мышлением temperature не задаётся.
# OPENROUTER_MODE=

# Необязательно: OpenAI-совместимый API (OpenAI, Ollama, vLLM, LM Studio)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b

# Тонкие настройки
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=6
# Пауза между запросами, сек (на бесплатном тарифе помогает не упираться в лимит RPM)
LLM_MIN_INTERVAL=4
# Максимальная длина ответа модели в токенах. У моделей с рассуждениями (Gemini 3/4) рассуждения
# расходуют тот же лимит: если ответ обрезается, агент скажет об этом прямо.
LLM_MAX_OUTPUT_TOKENS=32768
# Глубина рассуждений: low | medium | high (пусто — по умолчанию модели). low заметно быстрее.
# LLM_REASONING_EFFORT=low
# Запасная модель: если основная недоступна (429/503 после всех попыток), шаг повторяется на ней.
# Для Gemini: GEMINI_FALLBACK_MODEL, для OpenRouter: OPENROUTER_FALLBACK_MODEL (или общая LLM_FALLBACK_MODEL).
# GEMINI_FALLBACK_MODEL=
# Предохранитель: после стольких шагов подряд с недоступной моделью остальные шаги пропускаются.
LLM_BREAKER_AFTER=2
